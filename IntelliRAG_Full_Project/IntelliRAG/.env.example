# Copy this file to ".env" and fill in ONE of the keys.
# Without any key the app still works: it shows the best matching passages
# (retrieval only). With a key it writes full answers with citations.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Or OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or local Ollama (set LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# auto = Groq if key present, else OpenAI if key present, else retrieval-only
LLM_PROVIDER=auto
